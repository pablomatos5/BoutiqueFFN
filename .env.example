# Copie para .env (local) ou cadastre na Vercel em Settings → Environment Variables.
# Credenciais do contrato da loja com os Correios (portal "Meu Correios" / CWS):
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CARTAO_POSTAGEM=
# Opcionais
CORREIOS_CONTRATO=
CORREIOS_DR=
CEP_ORIGEM=68400000
CORREIOS_SERVICOS=03298:PAC,03220:SEDEX
CAIXA_CM=30,20,10

# Mercado Pago (Checkout Transparente): em mercadopago.com.br/developers → Suas integrações →
# sua aplicação → Credenciais. Use as de TESTE para testar e as de PRODUÇÃO para vender.
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Validade do QR Code Pix, em minutos
PIX_MINUTOS=30

# Aviso automático do Mercado Pago (Suas integrações → Webhooks → assinatura secreta).
# Cadastre a URL https://SEU-SITE/api/webhook-mp com o evento "Pagamentos".
MP_WEBHOOK_SECRET=
# Endereço público do site, ex.: https://boutiqueffn.com.br
SITE_URL=

# Banco dos pedidos: Vercel → Storage → KV/Upstash (as duas variáveis são criadas sozinhas).
# Sem elas, o `npm run dev` guarda os pedidos em data/pedidos.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Senha do painel da loja (painel.html) e um segredo extra para as sessões
PAINEL_SENHA=
PAINEL_SEGREDO=
