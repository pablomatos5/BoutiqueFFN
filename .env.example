# Copie para .env (local) ou cadastre na Vercel em Settings → Environment Variables.
# Credenciais do contrato da loja com os Correios (portal "Meu Correios" / CWS):
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CARTAO_POSTAGEM=
# Opcionais
CORREIOS_CONTRATO=
CORREIOS_DR=
CEP_ORIGEM=68400000
CORREIOS_SERVICOS=03298:PAC,03220:SEDEX
CAIXA_CM=30,20,10

# Mercado Pago (Checkout Pro): Access Token de produção em
# mercadopago.com.br/developers → Suas integrações → Credenciais
MP_ACCESS_TOKEN=
# Endereço público do site (opcional), ex.: https://boutiqueffn.com.br
SITE_URL=
